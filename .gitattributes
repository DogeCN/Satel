# 默认按文本处理，入库时统一为 LF。
# 不指定时 Windows 检出可能带 CRLF，gofmt 会把带 CRLF 的 .go 判为"未格式化"。
* text=auto eol=lf

*.go    text eol=lf
*.js    text eol=lf
*.mjs   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.sh    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.sql   text eol=lf
*.toml  text eol=lf
*.svg   text eol=lf

*.exe   binary
*.png   binary
*.zip   binary
LICENSE text eol=lf
NOTICE  text eol=lf
